{
  "manifest_version": 3,
  "name": "CollegeBoard+",
  "version": "1.0.6",
  "description": "Page themes and reading customization for College Board websites and their embedded quizzes.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CollegeBoard+",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.collegeboard.org/*"
      ],
      "css": [
        "startup.css"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.collegeboard.org/*",
        "https://*.learnosity.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
